# Copy to `.env` at the repo root and set your Hugging Face token
# for gated models.
#
# Required for:
#   - GigaTIME:     https://huggingface.co/prov-gigatime/GigaTIME
#   - UNI2-h:       https://huggingface.co/MahmoodLab/UNI2-h
#   - MIPHEI-ViT:   https://huggingface.co/bioptimus/H-optimus-0
#                   MIPHEI head weights come from the GitHub release URL
#                   in configs/benchmark_models.yaml, not Hugging Face.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Image root. Remaps paths under /data3/houjunlin/fxx/datasets in configs/datasets.yaml.
# HE_MIF_DATASETS_ROOT=/path/to/datasets

# Immunocto is not under that datasets root on the original machine:
# PREPATH_DATASET_IMMUNOCTO_DIR=/path/to/ImmunoctoV1

# Unfiltered Cell-niches HE/mIF FOVs (python -m preprocessing.build --dataset cell_niches):
# HE_MIF_CELL_NICHES_RAW=/path/to/Cell-niches-data

# Optional override for foundation-model weights (default: $PWD/checkpoints)
# HE_MIF_CKPT_DIR=/path/to/checkpoints
